# Copy to .env for local dev (Next.js also loads .env automatically):
#   cp .env.local.example .env
#
# NO SECRETS in this app — DB, JWT, Razorpay secrets live in study-cafe-api/.env.
# Razorpay checkout gets the public key from the API when you start payment.

NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
API_GATEWAY_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_ASSETS_ORIGIN=https://assets.studycafe.in
NEXT_PUBLIC_SITE_URL=https://studycafe.in

# NEXT_PUBLIC_MEDIA_ORIGIN=https://studycafe.in
# SERVER_API_BASE_URL=http://127.0.0.1:3000/api
