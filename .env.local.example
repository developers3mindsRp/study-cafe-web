# Optional: browser + SSR call the gateway directly (port 3000). Avoids relying on Next.js
# /api rewrites when the storefront runs on another port (e.g. http://localhost:3001).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Optional: same as next.config.mjs rewrite target (api-gateway). Used by middleware for SEO.
# API_GATEWAY_ORIGIN=http://127.0.0.1:3000
